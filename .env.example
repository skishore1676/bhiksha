POLYGON_API_KEY=

PUBLIC_SECRET_TOKEN=
PUBLIC_API_BASE_URL=https://api.public.com
PUBLIC_AUTH_ENDPOINT=https://api.public.com/userapiauthservice/personal/access-tokens
API_REQUESTS_PER_SECOND=5
API_BURST_LIMIT=5

SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8080
SCHWAB_AUTHORIZE_URL=https://api.schwabapi.com/v1/oauth/authorize
SCHWAB_TOKEN_URL=https://api.schwabapi.com/v1/oauth/token
SCHWAB_API_BASE_URL=https://api.schwabapi.com
SCHWAB_TOKEN_FILE=config/schwab_tokens.json
SCHWAB_TIMEOUT_SECONDS=20

DATABASE_URL=sqlite:///bhiksha.db
BHIKSHA_CASH_GUARD_MODE=auto
BHIKSHA_CASH_GUARD_BUFFER_PCT=0.05

# Google Sheet handoff
GOOGLE_SHEET_ID=
GOOGLE_API_CREDENTIALS_PATH=
MALA_EVIDENCE_SHEET_NAME=Mala_Evidence_v1
# Legacy alias still supported:
# STRATEGY_CATALOG_SHEET_NAME=Mala_Evidence_v1
OPERATOR_DEFAULTS_SHEET_NAME=Operator_Defaults_v1
ACTIVE_STRATEGIES_SHEET_NAME=active_strategy
MANUAL_ENTRY_SHEET_NAME=manual_entry

# Active plan sync/runtime paths
BHIKSHA_STRATEGY_CATALOG_PATH=config/strategy_catalog
BHIKSHA_ACTIVE_PLAN_PATH=artifacts/playbook/active_plan.json
BHIKSHA_ACTIVE_PLAN_LOG_DIR=artifacts/playbook/logs
BHIKSHA_ACTIVE_PLAN_SOURCE_NAME=google_sheet_integration
BHIKSHA_RUNTIME_PID_PATH=artifacts/playbook/runtime/bhiksha.pid
BHIKSHA_RUNTIME_LOG_DIR=artifacts/playbook/runtime
